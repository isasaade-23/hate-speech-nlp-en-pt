# Data (raw/interim/processed are reproducible from source zips in Downloads)
data/raw/
data/interim/
data/processed/
data/external/
!data/**/.gitkeep

# Models and large binaries (tracked via models/registry.json)
models/**/*.bin
models/**/*.safetensors
models/**/*.pt
models/**/*.onnx
models/**/*.joblib
models/**/*.pkl
# Stop-word ablation artifacts (secondary; kept untracked)
models/*_nostop_*/

# Logs and experiment tracking
logs/
!logs/.gitkeep
mlruns/

# Reports: figures are regenerable PNGs and stay out of git. Metrics, per-example
# predictions and derived tables ARE tracked: the neural runs come from Colab zips
# and cannot be regenerated locally without GPU (see reports/archive/ for v1).
reports/figures/*
!reports/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/

# Notebook outputs are stripped by nbstripout; ignore stray checkpoints
notebooks/**/*-checkpoint.ipynb

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets and local env
.env
*.local

# OS
Thumbs.db
.DS_Store

# Colab transfer bundles (regenerable)
hsc_neural_results.zip

# MkDocs build output
site/
.cache/

# Internal work log (private dev journal — never published to the portfolio repo)
_internal/
