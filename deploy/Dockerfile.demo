# Gradio demo image.
# Build from repo root:  docker build -f deploy/Dockerfile.demo -t hsc-demo .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    GRADIO_SERVER_NAME=0.0.0.0

WORKDIR /app

COPY deploy/requirements-serve.txt ./
RUN pip install -r requirements-serve.txt "gradio>=4.20"

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install -e . --no-deps

COPY demo ./demo
COPY configs ./configs
COPY models ./models

RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 7860
CMD ["python", "demo/app.py"]
