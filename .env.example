# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Kaggle API (only needed to re-download the source datasets)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Path to the original downloaded zips (immutable source)
HSC_SOURCE_DIR=C:\Users\Renato\Downloads\hate-speech

# MLflow tracking (local file store by default)
MLFLOW_TRACKING_URI=file:./logs/mlruns

# Product API
HSC_MODEL_ID=            # model_id from models/registry.json to serve
HSC_API_RATE_LIMIT=60/minute
