# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Kaggle API (only needed to re-download the source datasets)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Path to the original downloaded zips (immutable source)
HSC_SOURCE_DIR=/path/to/hate-speech

# MLflow tracking (local file store by default)
MLFLOW_TRACKING_URI=file:./logs/mlruns

# Product API
HSC_MODEL_ID=stack_strict_s42   # model_id from models/registry.json to serve
HSC_API_KEYS=            # nome:sha256hex,nome2:sha256hex (gerar com: python -m api.security NOME)
HSC_RATE_PER_MIN=600     # unidades por minuto por chave (/predict = 1, /predict_batch = len(texts))
# Optional: sibling repos used by scripts/ (default: ../hate-speech-space and ../luciola-extension)
# HSC_SPACE_DIR=/path/to/hate-speech-space
# HSC_EXT_DIR=/path/to/luciola-extension
